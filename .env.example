# Copy this file to .env.local. Defaults work locally without external services.
# Hosted PostgreSQL connection (server-only). Empty uses persistent local PGlite.
DATABASE_URL=
# Optional privileged URI for explicit migration/seed commands only; not used by the app.
DATABASE_MIGRATION_URL=
# URI must match: session (Supabase session pooler :5432) or direct. Transaction pooling is unsupported.
DATABASE_CONNECTION_MODE=session
# Connections per warm application instance. Increase only within the database connection budget.
DATABASE_POOL_MAX=1
# Verified TLS for hosted databases. disable is only for loopback PostgreSQL in development.
DATABASE_SSL=verify-full
# Optional server root CA as PEM (literal newlines or \n); not a certificate file path.
DATABASE_SSL_CA=
# Exact browser origin. Required in production (HTTPS; http only for a loopback preview).
# Reset links and CSRF checks use this value, never the request Host header.
APP_URL=http://127.0.0.1:3000
# Anonymous demo accounts in production. Development always allows them.
# Keep false for student rollout; set true only for a local PGlite production preview.
# Demo accounts expire after 24 hours and are capped at 500.
ENABLE_DEMO=false
# Optional local storage root, including database and captured development mail.
FOLIO_DATA_DIR=.data
# SMTP URL for real reset-email delivery. Example: smtps://user:password@smtp.example.com:465
# Empty captures mail locally in development; production responds with unavailable.
SMTP_URL=
MAIL_FROM=Folio <hello@example.com>
# Only used by npm run admin. Prefer setting the password temporarily in the shell.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Only used by npm run professor. Set the password temporarily when provisioning.
PROFESSOR_NAME=
PROFESSOR_EMAIL=
PROFESSOR_PASSWORD=
# Optional Tutor and exercise generation. Both stay server-side; blank key keeps saved practice available.
OPENAI_API_KEY=
# Responses API model with structured output support; choose one enabled for your account.
OPENAI_MODEL=gpt-4o-mini
